{
  "name": "jamesmarciano",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tunnel": "dotenv -- bash -c 'ngrok http http://localhost:$VITE_PORT --url $VITE_NGROK_HOST --traffic-policy-file ngrok_config.yml --log=stdout'",
    "dev:ngrok": "concurrently \"npm run dev\" \"npm run tunnel\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "dotenv-cli": "^11.1.0",
    "vite": "^8.3.6"
  }
}
